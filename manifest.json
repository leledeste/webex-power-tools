{
  "manifest_version": 3,
  "name": "Webex Power Tools",
  "version": "1.0.0",
  "description": "Enhanced Webex recording controls: hold to speed up, seek gestures, keyboard shortcuts, reversible mute and on-screen indicators.",
  "permissions": [
    "storage",
    "declarativeContent"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Webex Power Tools",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    },
    "default_state": "disabled"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.webex.com/*"
      ],
      "js": [
        "settings.js",
        "i18n.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon48.png"
      ],
      "matches": [
        "https://*.webex.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "127"
}
